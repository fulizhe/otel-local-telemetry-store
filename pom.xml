<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>io.github.fulizhe</groupId>
  <artifactId>otel-local-telemetry-store</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <packaging>jar</packaging>

  <name>otel-local-telemetry-store</name>
  <description>Bounded in-process telemetry storage for the OpenTelemetry Java agent</description>

  <licenses>
    <license>
      <name>Apache-2.0</name>
      <url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
    </license>
  </licenses>

  <properties>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
    <maven.compiler.release>8</maven.compiler.release>
    <junit.version>5.10.2</junit.version>
    <otel.javaagent.version>2.32.0</otel.javaagent.version>
    <otel.extension.api.version>2.32.0-alpha</otel.extension.api.version>
    <!--
      SPI 版本必须与 agent 内嵌的那份逐方法一致，否则运行期 NoSuchMethodError。
      已核对：1.66.0 与 agent 2.32.0 的 AutoConfigurationCustomizer 方法完全相同。
      见 docs/notes/2026-10-04-r0-extension-points.md
    -->
    <otel.sdk.version>1.66.0</otel.sdk.version>
  </properties>

  <dependencies>
    <dependency>
      <groupId>io.opentelemetry.javaagent</groupId>
      <artifactId>opentelemetry-javaagent-extension-api</artifactId>
      <version>${otel.extension.api.version}</version>
      <scope>provided</scope>
    </dependency>

    <!-- 扩展点本体。显式声明，不靠上面那个的传递依赖 —— 编译直接引用的类型必须自己钉住版本。 -->
    <dependency>
      <groupId>io.opentelemetry</groupId>
      <artifactId>opentelemetry-sdk-extension-autoconfigure-spi</artifactId>
      <version>${otel.sdk.version}</version>
      <scope>provided</scope>
    </dependency>

    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <version>${junit.version}</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.13.0</version>
      </plugin>

      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>3.2.5</version>
      </plugin>
    </plugins>
  </build>
</project>