<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>2.7.18</version>
    <relativePath/>
  </parent>

  <groupId>io.github.fulizhe</groupId>
  <artifactId>otel-local-telemetry-store-demo</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <packaging>jar</packaging>

  <name>otel-local-telemetry-store-demo</name>
  <description>造三个信号的演示应用与端到端验证靶子</description>

  <properties>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <!--
      刻意锁 Java 8：本仓库的字节码基线是 8，demo-app 与扩展跑在同一个 JVM 上，
      用 8 才能顺带验证"扩展在 JDK 8 应用里可用"这句话不是空话。
      Spring Boot 2.7.18 是 2.x 末代，支持 Java 8。
    -->
    <java.version>8</java.version>
    <!-- 必须与 agent 内嵌的 SDK 版本一致，否则应用侧 API 与 agent 侧 SDK 不同源 -->
    <otel.api.version>1.66.0</otel.api.version>
    <!--
      Kafka broker（KRaft 单节点）。2.8.2 是**带 in-process KRaft broker 的最低一代**：
      2.7 只有 Raft 元数据 quorum，没有 KafkaRaftServer / StorageTool。
      broker 字节码实测 52，仍支持 Java 8。
    -->
    <kafka.version>2.8.2</kafka.version>
    <!-- gRPC：真端口 Netty server + 手搓 descriptor，不用 protoc。1.58.0 在仪表化支持范围内 -->
    <grpc.version>1.58.0</grpc.version>
    <!-- MySQL 驱动：唯一外部依赖那一跳。8.0.26 字节码实测 52（8.0.33 起上到 55） -->
    <mysql.version>8.0.26</mysql.version>
  </properties>

  <dependencies>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>

    <!--
      应用侧自己发信号需要 OTel API。agent 不会白给这三个 jar
      （缺 opentelemetry-common 会报 NoClassDefFoundError，见 docs/notes/2026-10-04-r0-extension-points.md）。
    -->
    <dependency>
      <groupId>io.opentelemetry</groupId>
      <artifactId>opentelemetry-api</artifactId>
      <version>${otel.api.version}</version>
    </dependency>

    <!--
      H2：五类外部依赖里的第一跳（进程内内存库）。
      **只引驱动，不引 spring-boot-starter-jdbc** —— 理由与下面 Redis/Kafka 那几跳同源：
      starter 会把连接池一起拖进来，而连接池的获取本身会被仪表化成 span，
      链路图上多出来的不是我们想展示的东西。用裸驱动时 scopeName=jdbc 的
      CLIENT span 数量恰好等于我们真的发了几条 SQL。
    -->
    <dependency>
      <groupId>com.h2database</groupId>
      <artifactId>h2</artifactId>
      <scope>runtime</scope>
    </dependency>

    <!--
      Redis 那两跳：客户端用**裸 Jedis**，服务端内嵌。

      **不用 spring-boot-starter-data-redis** —— 它管理的 Lettuce 6.x 落在 agent 2.32.0
      的仪表化支持范围外（Lettuce 支持到 5.x），会**静默不生效**：
      代码跑得通、span 就是没有，而页面上看不出任何异常。
      这不是"配置错了"，是选型错了，所以整个 starter 都不引。

      embedded-redis 里是 **redis-server 2.8.19**（很老）。**不用升级**：
      Jedis 的 span 来自客户端方法，服务端版本不影响埋点。
    -->
    <dependency>
      <groupId>redis.clients</groupId>
      <artifactId>jedis</artifactId>
      <version>3.8.0</version>
    </dependency>
    <dependency>
      <groupId>it.ozimov</groupId>
      <artifactId>embedded-redis</artifactId>
      <version>0.7.3</version>
      <exclusions>
        <!--
          它要 slf4j-simple，而本应用已经有 logback —— 两个 binding 同时在，
          日志会走 slf4j-simple 打到 stderr，demo-app 的日志格式配置就整个失效了
          （agent 正是把日志改到 stderr 上，格式一乱就没法读了）。
        -->
        <exclusion>
          <groupId>org.slf4j</groupId>
          <artifactId>slf4j-simple</artifactId>
        </exclusion>
      </exclusions>
      <!--
        guava **不排**：RedisServerBuilder 运行时真的要 com.google.common.collect.Maps。
        排掉之后 NoClassDefFoundError 出现在**探测里** —— 而探测已经把异常压成
        ready=false 了，读起来像"Redis 起不来"，真因却是依赖被排没了。
        这就是"降级掩盖了配置错误"：最难查的一类，所以测试直接跑真的探测。
      -->
    </dependency>

    <!--
      Kafka：**内嵌 broker + 内嵌 ZooKeeper**（都在进程内，零外部进程）。

      想用 KRaft 的话会撞墙：KRaft 在这台 Windows 上起不来 ——
      kafka.raft.KafkaRaftManager 把 @metadata-0/quorum-state.tmp 改名成 quorum-state 时
      源文件仍被本进程持有句柄，Windows 拒绝该 rename。所以走 ZK 模式。

      版本钉 2.8.2：ZK 模式的末代之一，broker 字节码实测 52，仍支持 Java 8。

      **不用 spring-kafka**：它管理的 kafka-clients 3.x 落在 agent 2.32.0 的
      仪表化支持范围外（支持到 2.5+），会**静默不生效**。
    -->
    <dependency>
      <groupId>org.apache.kafka</groupId>
      <artifactId>kafka_2.13</artifactId>
      <version>${kafka.version}</version>
      <exclusions>
        <!--
          Kafka 用 log4j 1.x 打日志。本应用有 logback —— 两者都在时日志走 log4j，
          demo-app 的日志格式配置整个失效（而 agent 正是把日志改到 stderr 上的，
          格式一乱验收信号就没法读了）。
        -->
        <exclusion>
          <groupId>org.slf4j</groupId>
          <artifactId>slf4j-log4j12</artifactId>
        </exclusion>
      </exclusions>
    </dependency>
    <!--
      ZooKeeper：我们**直接**起它（内嵌），所以显式声明而不是靠 kafka_2.13 的传递依赖。
      版本与 kafka_2.13:2.8.2 拉进来的那个一致，避免两条路径各带一个版本。
    -->
    <dependency>
      <groupId>org.apache.zookeeper</groupId>
      <artifactId>zookeeper</artifactId>
      <version>3.5.9</version>
      <exclusions>
        <exclusion>
          <groupId>org.slf4j</groupId>
          <artifactId>slf4j-log4j12</artifactId>
        </exclusion>
        <exclusion>
          <groupId>ch.qos.logback</groupId>
          <artifactId>logback-classic</artifactId>
        </exclusion>
        <exclusion>
          <groupId>ch.qos.logback</groupId>
          <artifactId>logback-core</artifactId>
        </exclusion>
      </exclusions>
    </dependency>

    <!--
      gRPC：**真端口的 Netty server**（不用 protoc）。

      **不用 protoc / protobuf 代码生成**：手搓 MethodDescriptor<byte[],byte[]> 加
      一个 byte[] identity marshaller 就够了，而它换来的是**两侧都产生 span**
      （CLIENT 由调用方、SERVER 由服务端），是五跳里链最深的一条。

      版本 1.58.0：在 agent 2.32.0 的 gRPC 仪表化支持范围（1.6+）内。
    -->
    <dependency>
      <groupId>io.grpc</groupId>
      <artifactId>grpc-netty-shaded</artifactId>
      <version>${grpc.version}</version>
    </dependency>
    <dependency>
      <groupId>io.grpc</groupId>
      <artifactId>grpc-stub</artifactId>
      <version>${grpc.version}</version>
    </dependency>

    <!--
      MySQL：**五跳里唯一的外部依赖**（ADR-7 —— 没有可嵌入的 MySQL 服务端实现）。
      连本机已在跑的实例，连不上就降级。

      只引驱动，不引 MySQL 方言的 JDBC starter：与 H2 同一条理由 ——
      starter 会把连接池拖进来，而连接池的获取本身会被仪表化成 span，
      图上多出来的不是想展示的东西。
    -->
    <dependency>
      <groupId>mysql</groupId>
      <artifactId>mysql-connector-java</artifactId>
      <version>${mysql.version}</version>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
      </plugin>
    </plugins>
  </build>
</project>